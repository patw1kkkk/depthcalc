{
  "name": "depthcalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:capture": "vite --host 0.0.0.0 --port 5173 --open /apps/capture/",
    "dev:studio": "vite --host 0.0.0.0 --port 5174 --open /apps/studio/",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests docs *.ts *.json *.md *.html",
    "format:check": "prettier --check apps packages tests docs *.ts *.json *.md *.html"
  },
  "dependencies": {
    "@types/earcut": "^3.0.0",
    "earcut": "^3.2.4",
    "jspdf": "4.2.1",
    "lucide-react": "1.31.0",
    "osmtogeojson": "3.0.0-beta.5",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.19.19",
    "@types/osmtogeojson": "2.2.34",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
